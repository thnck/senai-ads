    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="c" type="Integer" array="False" size=""/>
            <declare name="f" type="Real" array="False" size=""/>
            <output expression="&quot;Digite uma temperatura em Celsius para saber seu valor em Fahrenheit:&quot;" newline="True"/>
            <input variable="c"/>
            <assign variable="f" expression="(c * 9 / 5) + 32"/>
            <output expression="&quot;A temperatura em Fahrenheit &#233; &quot; &amp; f&amp;&quot;.&quot;" newline="True"/>
        </body>
    </function>
