    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="altura" type="Integer" array="False" size=""/>
            <declare name="base" type="Integer" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a altura do seu tri&#226;ngulo&quot;" newline="True"/>
            <input variable="altura"/>
            <output expression="&quot;Digite a base do seu tri&#226;ngulo&quot;" newline="True"/>
            <input variable="base"/>
            <assign variable="area" expression="altura*base"/>
            <output expression="&quot;A &#225;rea do seu tri&#226;ngulo &#233; &quot; &amp; area &amp; &quot;.&quot;" newline="True"/>
        </body>
